# Copia este archivo como .env (ignorado por git) y cambia los valores.
# Clave HMAC para firmar los JWT: mínimo 32 caracteres. Genera una con: openssl rand -base64 48
JWT_KEY=cambia-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres
ADMIN_USER=admin
ADMIN_PASSWORD=Admin123!
POSTGRES_PASSWORD=postgres
